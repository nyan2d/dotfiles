# prompt
PROMPT="%F{10}%n%f %F{15}%~%f%F{40} $ %f"

# autocomplete
autoload -Uz compinit && compinit

# truecolor mode
export COLORTERM=truecolor

# vim mode
bindkey -v
export KEYTIMEOUT=1

# envs
export EDITOR=nvim
export GOPROXY=https://goproxy.cn,direct
path+=($HOME'/go/bin')
export PATH

# aliases
alias ls="ls --color=auto"
alias ll="ls -l --color=auto"
alias vim="nvim"
alias vi="nvim"
alias lg="lazygit"
alias py="python"

# vim cursor mode
cursor_mode() {
    cursor_block='\e[2 q'
    cursor_beam='\e[6 q'

    function zle-keymap-select {
        if [[ ${KEYMAP} == vicmd ]] ||
            [[ $1 = 'block' ]]; then
            echo -ne $cursor_block
        elif [[ ${KEYMAP} == main ]] ||
            [[ ${KEYMAP} == viins ]] ||
            [[ ${KEYMAP} = '' ]] ||
            [[ $1 = 'beam' ]]; then
            echo -ne $cursor_beam
        fi
    }

    zle-line-init() {
        echo -ne $cursor_beam

    }

    zle -N zle-keymap-select
    zle -N zle-line-init

}
cursor_mode

